# Root Environment Variables — AgentWatch
# Copy to .env and fill all values. NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────
NODE_ENV=development
APP_NAME=AgentWatch
APP_VERSION=1.0.0

# ─── Backend ──────────────────────────────────────────────
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentwatch
POSTGRES_USER=agentwatch_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_64_BYTES
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── TURN Server ──────────────────────────────────────────
TURN_SERVER_URL=turn:your-turn-server.internal:3478
TURN_SECRET=CHANGE_THIS_TURN_SECRET
TURN_CREDENTIAL_TTL_SECONDS=300

# ─── MFA ──────────────────────────────────────────────────
MFA_ISSUER=AgentWatch

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100

# ─── Session ──────────────────────────────────────────────
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET
MAX_SESSION_DURATION_MINUTES=120

# ─── Audit Retention ──────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=365
MONITORING_SESSION_RETENTION_DAYS=90

# ─── Allowed CORS Origins ─────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Device Auth ──────────────────────────────────────────
DEVICE_JWT_SECRET=CHANGE_THIS_DEVICE_JWT_SECRET
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_OFFLINE_THRESHOLD_SECONDS=90

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
