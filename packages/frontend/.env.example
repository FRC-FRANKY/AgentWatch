# ── Local Development ─────────────────────────────────────────────────────────
# Copy to .env and fill in values before running locally.
# In production (Vercel), VITE_API_URL is set to /api via vercel.json environment.

# Backend API base URL (local dev only — Vercel uses /api via the proxy rewrite)
VITE_API_URL=http://localhost:4000/api

# WebSocket URL (local dev only — Vercel uses wss://{host}/ws/signal automatically)
# The app falls back to wss://{window.location.host}/ws/signal if this is unset,
# which is exactly what you want in production. Only set this for local dev.
VITE_WS_URL=ws://localhost:4000/ws/signal

VITE_APP_NAME=AgentWatch
VITE_PORT=5173

# ── Firebase Client Config (public — not secrets) ─────────────────────────────
# These values identify your Firebase project for the Web SDK.
# Found in: Firebase Console → Project Settings → General → Your apps → Web app
# They are safe to include in the frontend bundle (access is controlled by
# Firebase Security Rules and Firebase Auth, NOT by keeping the key secret).
#
# Set these in Vercel environment variables (or local .env) to enable:
#   - Real-time device status badges (ONLINE/OFFLINE) via Firestore
#   - Live session lifecycle state (PENDING → CONNECTED → ENDED)
#   - Live dashboard stat counters (online agents, active monitoring)
#
# If left unset, all real-time features degrade gracefully to API polling.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
