# AgentWatch Agent Client — Environment Configuration
# Copy to .env and fill in values before running.

# Required: URL of the AgentWatch backend API
AGENT_BACKEND_URL=http://localhost:4000/api

# Required on FIRST run only: enrollment token from your manager
# After successful enrollment, this will be cleared from the config file.
# AGENT_ENROLLMENT_TOKEN=abc123def456...

# Optional: override device name (defaults to system hostname)
# AGENT_DEVICE_NAME=WORKSTATION-001

# Optional: heartbeat interval in seconds (default: 30)
# AGENT_HEARTBEAT_INTERVAL_SECONDS=30

# Optional: log level (debug | info | warn | error)
# LOG_LEVEL=info

# Optional: path to persist the config file (default: ~/.agentwatch/agent-config.json)
# AGENT_CONFIG_PATH=/etc/agentwatch/agent-config.json
