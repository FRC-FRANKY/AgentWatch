# Backend Environment Variables — AgentWatch
# Copy to .env and fill all values. NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://agentwatch_user:CHANGE_PASSWORD@localhost:5432/agentwatch_dev
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=2000

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=changeme

# ─── JWT ──────────────────────────────────────────────────
# Generate: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_RANDOM_VALUE
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_RANDOM_VALUE
JWT_REFRESH_EXPIRY=7d
# Separate secret for partial (pre-MFA) tokens
JWT_PARTIAL_SECRET=REPLACE_WITH_ANOTHER_UNIQUE_64_BYTE_HEX_RANDOM_VALUE

# ─── Device JWT ───────────────────────────────────────────
DEVICE_JWT_SECRET=REPLACE_WITH_ANOTHER_64_BYTE_HEX_RANDOM_VALUE
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_OFFLINE_THRESHOLD_SECONDS=90

# ─── MFA ──────────────────────────────────────────────────
MFA_ISSUER=AgentWatch
MFA_TOTP_STEP=30
MFA_TOTP_DIGITS=6
# 64 hex chars (32 bytes) for AES-256-GCM TOTP secret encryption
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_RANDOM_VALUE

# ─── TURN Server ──────────────────────────────────────────
TURN_SERVER_URLS=turn:your-turn-server.internal:3478
TURN_SECRET=REPLACE_WITH_TURN_SERVER_SECRET
TURN_CREDENTIAL_TTL_SECONDS=300

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=200

# ─── Cookies ──────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ─── Session ──────────────────────────────────────────────
MAX_SESSION_DURATION_MINUTES=120
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# ─── Retention ────────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=365
MONITORING_SESSION_RETENTION_DAYS=90
SECURITY_EVENT_RETENTION_DAYS=365
REFRESH_TOKEN_RETENTION_DAYS=30

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Account Security ─────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Enable in-memory demo mode (no database required).
# USE_DEMO_MODE=true   ← local dev only; NEVER enable in production.
# Demo accounts are defined in src/modules/auth/auth.service.ts (dev only).
# Run `npm run db:seed` to create real accounts in the database.